# Copie para .env e preencha. O .env NAO vai para o git.
DB_HOST=mybarber.mysql.dbaas.com.br
DB_PORT=3306
DB_NAME=mybarber
DB_USER=mybarber
DB_PASSWORD=
DB_SSL=false

# Gere com: openssl rand -base64 48
JWT_SECRET=
JWT_MINUTOS=60
JWT_DIAS_REFRESH=30

# Super admin criado na primeira execucao
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Origens do portal React (separadas por virgula)
CORS_ORIGINS=http://localhost:5173
PORT=8080
